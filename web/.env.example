# Copy to .env.local for local dev. Real values live only in the Vercel project via-labs-merch.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://merch.getvia.xyz
JOBS_SECRET=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
RESEND_API_KEY=
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=
# Gmail connector (Google Cloud OAuth client, type Web application;
# redirect URI https://merch.getvia.xyz/api/connect/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seals OAuth refresh tokens in merch.channels.auth_enc: openssl rand -base64 32
MERCH_TOKEN_KEY=
